import pandas as pd
import numpy as np
from sklearn.model_selection import train_test_split
from sklearn.tree import DecisionTreeClassifier, export_text
from sklearn.preprocessing import LabelEncoder
from sklearn.metrics import accuracy_score

# -----------------------------
# STEP 1: Create Dataset Again
# -----------------------------

np.random.seed(42)
rows = 300

data = {
    "Machine_ID": np.arange(1, rows + 1),
    "Temperature_C": np.round(np.random.uniform(40, 120, rows), 2),
    "Vibration_mm_s": np.round(np.random.uniform(0.5, 10.0, rows), 2),
    "Pressure_bar": np.round(np.random.uniform(1, 10, rows), 2),
    "Humidity_percent": np.round(np.random.uniform(20, 90, rows), 2),
    "Motor_Current_A": np.round(np.random.uniform(5, 50, rows), 2),
    "System_Latency_ms": np.random.randint(10, 200, rows)
}

fault_score = (
    (data["Temperature_C"] > 90).astype(int) +
    (data["Vibration_mm_s"] > 6).astype(int) +
    (data["Motor_Current_A"] > 35).astype(int)
)

fault_label = np.where(fault_score == 0, "Normal",
               np.where(fault_score == 1, "Minor_Fault",
               "Critical_Fault"))

data["Fault_Status"] = fault_label

df = pd.DataFrame(data)

# -----------------------------
# STEP 2: Encode Target
# -----------------------------

for column in df.select_dtypes(include=['object']).columns:
    df[column] = LabelEncoder().fit_transform(df[column])

# -----------------------------
# STEP 3: Low Accuracy Model
# -----------------------------

X = df.drop("Fault_Status", axis=1)
y = df["Fault_Status"]

# Very small training data
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.85, random_state=1
)

# Very shallow model (weak learner)
model = DecisionTreeClassifier(max_depth=1)
model.fit(X_train, y_train)

y_pred = model.predict(X_test)

accuracy = accuracy_score(y_test, y_pred)

print("Low Accuracy:", accuracy * 100, "%")

print("\nGenerated Simple Rule:\n")
print(export_text(model, feature_names=list(X.columns)))
