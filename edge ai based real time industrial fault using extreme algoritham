import numpy as np
import pandas as pd
from sklearn.model_selection import train_test_split
from sklearn.preprocessing import LabelEncoder, StandardScaler
from sklearn.metrics import accuracy_score, classification_report

# ---------------------------------
# STEP 1: Create Industrial Dataset
# ---------------------------------

np.random.seed(42)
rows = 300

data = {
    "Machine_ID": np.arange(1, rows + 1),
    "Temperature_C": np.round(np.random.uniform(40, 120, rows), 2),
    "Vibration_mm_s": np.round(np.random.uniform(0.5, 10.0, rows), 2),
    "Pressure_bar": np.round(np.random.uniform(1, 10, rows), 2),
    "Humidity_percent": np.round(np.random.uniform(20, 90, rows), 2),
    "Motor_Current_A": np.round(np.random.uniform(5, 50, rows), 2),
    "System_Latency_ms": np.random.randint(10, 200, rows)
}

fault_score = (
    (data["Temperature_C"] > 90).astype(int) +
    (data["Vibration_mm_s"] > 6).astype(int) +
    (data["Motor_Current_A"] > 35).astype(int)
)

fault_label = np.where(fault_score == 0, "Normal",
               np.where(fault_score == 1, "Minor_Fault",
               "Critical_Fault"))

data["Fault_Status"] = fault_label

df = pd.DataFrame(data)

# ---------------------------------
# STEP 2: Encode Target
# ---------------------------------

label_encoder = LabelEncoder()
df["Fault_Status"] = label_encoder.fit_transform(df["Fault_Status"])

X = df.drop("Fault_Status", axis=1).values
y = df["Fault_Status"].values

# Scale features
scaler = StandardScaler()
X = scaler.fit_transform(X)

# Train-test split
X_train, X_test, y_train, y_test = train_test_split(
    X, y, test_size=0.3, random_state=42
)

# ---------------------------------
# STEP 3: Extreme Learning Machine
# ---------------------------------

class ELM:
    def __init__(self, input_size, hidden_size):
        self.input_size = input_size
        self.hidden_size = hidden_size
        
        # Random weights
        self.W = np.random.randn(self.input_size, self.hidden_size)
        self.b = np.random.randn(self.hidden_size)
    
    def sigmoid(self, x):
        return 1 / (1 + np.exp(-x))
    
    def fit(self, X, y):
        # Convert to one-hot encoding
        y_onehot = np.eye(len(np.unique(y)))[y]
        
        H = self.sigmoid(np.dot(X, self.W) + self.b)
        H_pinv = np.linalg.pinv(H)
        self.beta = np.dot(H_pinv, y_onehot)
    
    def predict(self, X):
        H = self.sigmoid(np.dot(X, self.W) + self.b)
        output = np.dot(H, self.beta)
        return np.argmax(output, axis=1)

# Initialize ELM
input_size = X_train.shape[1]
hidden_size = 20   # Increase for higher accuracy

elm = ELM(input_size, hidden_size)
elm.fit(X_train, y_train)

# Predict
y_pred = elm.predict(X_test)

# Accuracy
accuracy = accuracy_score(y_test, y_pred)

print("ELM Accuracy:", accuracy * 100, "%")
print("\nClassification Report:\n")
print(classification_report(y_test, y_pred))
